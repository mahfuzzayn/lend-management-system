# Lend Management System - environment template (requirements §12).
# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (server only).
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/lendbook?retryWrites=true&w=majority
# Local : mongodb://127.0.0.1:27017/lendbook
MONGODB_URI=

# JWT signing secret (server only) - at least 32 random chars. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# First admin - consumed by `npm run seed`.
# v1's demo credential was admin@lendbook.app / admin1234; pick a real password for v2.
ADMIN_NAME=Mahfuz Zayn
ADMIN_EMAIL=admin@lendbook.app
ADMIN_PASSWORD=

# Client-visible app name (mirrored by src/lib/config.ts).
NEXT_PUBLIC_APP_NAME=Lendbook

# RBAC role for the seeded admin (requirements 1.4): super-admin | admin.
# Defaults to super-admin. Create further admins with:
#   npm run seed -- --create-admin "Name" email password --role=admin
ADMIN_ROLE=super-admin
